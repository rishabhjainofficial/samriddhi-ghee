# Database Configuration (SQLite local or PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Pluggable Service Providers (MOCK | RAZORPAY | SHIPROCKET)
PAYMENT_PROVIDER="MOCK"
SHIPPING_PROVIDER="MOCK"

# Production Payment Gateway (when ready to connect live credentials)
# RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
# RAZORPAY_WEBHOOK_SECRET="your_webhook_signing_secret"

# Production Logistics Gateway (Shiprocket)
# SHIPROCKET_EMAIL="logistics@sanvritghee.com"
# SHIPROCKET_PASSWORD="your_shiprocket_password"

# Session & Authentication Cryptographic Secret (min 32 random characters)
ADMIN_SESSION_SECRET="generate-a-strong-random-secret-here-min-32-chars"
